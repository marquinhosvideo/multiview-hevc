# Configuração da POC. Todos os scripts leem este arquivo.
# Você pode sobrescrever qualquer valor pela linha de comando, ex.:
#   BITRATE=3000000 make encode

# Resolução de CADA câmera (tile). Largura e altura precisam ser múltiplos de 64
# (tamanho do CTU do Kvazaar). 1024x576 é 16:9 exato e múltiplo de 64.
TILE_W=${TILE_W:-1024}
TILE_H=${TILE_H:-576}

# Frame rate e GOP. O GOP (intervalo de IDR) define o tamanho do segmento:
# SEG_DUR = GOP / FPS. 60 frames a 30 fps = segmentos de 2 s.
FPS=${FPS:-30}
GOP=${GOP:-60}

# Duração de cada clipe em segundos. O total de frames é arredondado para um
# múltiplo do GOP (senão o loop "ao vivo" desalinha os IDRs entre voltas).
CLIP_SECONDS=${CLIP_SECONDS:-20}

# Bitrate alvo por câmera (bps) e preset do Kvazaar.
BITRATE=${BITRATE:-2500000}
KVZ_PRESET=${KVZ_PRESET:-veryfast}

# Nível HEVC sinalizado. Precisa comportar o canvas 2x2 (2048x1152@30 -> 5.1).
HEVC_LEVEL=${HEVC_LEVEL:-5.1}

# Servidor ao vivo local.
LIVE_PORT=${LIVE_PORT:-8080}
LIVE_TSB=${LIVE_TSB:-30}          # time-shift buffer do MPD, em segundos
CLIENT_DELAY_MS=${CLIENT_DELAY_MS:-6000}  # quanto o cliente começa atrás do live edge
